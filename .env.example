# Quran Reels Maker - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# YOUTUBE API (required for uploads)
# =============================================================================
# Get these from Google Cloud Console
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# =============================================================================
# AUTOMATIC PUBLICATION REVIEW (required for every automatic publishing route)
# =============================================================================
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get your chat ID by messaging @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here
# Exact Telegram user ID allowed to approve (including in private chats)
TELEGRAM_APPROVER_ID=
# Expected account identities; mismatch or missing values stop automatic publication
YOUTUBE_EXPECTED_CHANNEL_ID=
TIKTOK_EXPECTED_OPEN_ID=
# Kept for compatibility; automatic routes always require bound approval
APPROVAL_REQUIRED=true
# How long to wait for approval (in seconds)
APPROVAL_TIMEOUT_SECONDS=3600

# =============================================================================
# PEXELS API (for dynamic backgrounds)
# =============================================================================
# Get a free API key from https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# =============================================================================
# SCHEDULING
# =============================================================================
DAILY_POST_HOUR=6
DAILY_POST_MINUTE=0
TIMEZONE=Africa/Cairo

# =============================================================================
# CONTENT SETTINGS
# =============================================================================
# Longform default reciter (blank also selects alafasy).
# Shorts rotate Minshawi Mujawwad, Al-Banna, Yasser Al-Dossari.
DEFAULT_RECITER=alafasy
MAX_REEL_DURATION_SECONDS=59

# Legacy setting; automatic Shorts now traverse all 114 surahs, including Fridays.
# Friday longform scheduling is configured separately.
FRIDAY_MODE_ENABLED=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# SYSTEM PATHS (Windows)
# =============================================================================
# Path to ImageMagick binary (required for text overlays)
IMAGEMAGICK_BINARY=C:\Program Files\ImageMagick-7.1.2-Q16-HDRI\magick.exe

# Path to FFmpeg binary (auto-detected if in PATH)
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe

# =============================================================================
# VISUAL ENHANCEMENTS
# =============================================================================
# Enable 3-second intro frame with surah title
ENABLE_INTRO_FRAME=true

# Enable subtle Ken Burns (slow zoom) effect on background
ENABLE_KEN_BURNS=true

# =============================================================================
# AI BRAIN SETTINGS (OpenRouter)
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
# Religious metadata stays canonical by default; AI suggestions require final review
ENABLE_AI_METADATA=false
# Generated image backgrounds are also optional and require final visual/source review
ENABLE_AI_BACKGROUNDS=false

# =============================================================================
# TIKTOK API (optional, for automated Shorts uploads)
# =============================================================================
# Get these from TikTok for Developers console (https://developers.tiktok.com/)
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
ENABLE_TIKTOK_AUTOPUBLISH=false
# Test mode only generates media; it does not upload privately or publicly

